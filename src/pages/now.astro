---
import Base from "../layouts/Base.astro";

/** Update this date whenever you edit the page. */
const updated = new Date("2026-09-03");

const blocks = [
  {
    label: "Building",
    items: [
      "PlanVault — a planning system that lives inside my notes.",
      "This site. Trying to make it feel handmade without being fussy.",
    ],
  },
  {
    label: "Learning",
    items: [
      "Type on the web: optical sizing, variable fonts, restraint.",
      "Writing more often, editing less anxiously.",
    ],
  },
  {
    label: "Reading",
    items: ["More fiction than I have in years.", "Essays about small software."],
  },
  {
    label: "Elsewhere",
    items: ["Long walks. Coffee I grind too coarse. Saying yes to fewer things."],
  },
];

const long = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Base title="Now" description="What I'm focused on at the moment.">
  <section class="wrap head" data-reveal-group>
    <span class="kicker" data-reveal><span class="idx">[ / ]</span> Now</span>
    <h1 data-reveal>What I&rsquo;m doing<br />right now.</h1>
    <p class="lead" data-reveal>
      A <a class="link" href="https://nownownow.com/about" target="_blank" rel="noopener">now page</a>:
      a snapshot of what has my attention, kept honest by a date.
    </p>
    <p class="stamp" data-reveal>Last updated {long(updated)}</p>
  </section>

  <section class="wrap">
    <dl class="now-grid" data-reveal-group>
      {
        blocks.map((b) => (
          <div class="now-block" data-reveal>
            <dt>{b.label}</dt>
            <dd>
              <ul>
                {b.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 7vw, 4rem);
  }
  .head h1 {
    font-size: var(--step-3);
  }
  .stamp {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }

  .now-grid {
    display: grid;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .now-block {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--bg);
  }
  .now-block dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .now-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--text-dim);
  }
  .now-block li {
    position: relative;
    padding-left: 1.1rem;
  }
  .now-block li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--text-faint);
  }

  @media (max-width: 560px) {
    .now-block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
