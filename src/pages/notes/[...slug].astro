---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const long = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<Base title={note.data.title} description={note.data.description}>
  <article class="wrap note">
    <header class="note-head" data-reveal-group>
      <a class="back arrow-link" href="/notes" data-reveal>←&nbsp; Notes</a>
      <h1 data-reveal>{note.data.title}</h1>
      <div class="meta" data-reveal>
        <time datetime={note.data.date.toISOString()}>{long(note.data.date)}</time>
        {
          note.data.updated && (
            <span>· updated {long(note.data.updated)}</span>
          )
        }
        {
          note.data.tags.length > 0 && (
            <span class="tags">
              {note.data.tags.map((t) => (
                <span class="tag">#{t}</span>
              ))}
            </span>
          )
        }
      </div>
    </header>

    <div class="prose" data-reveal>
      <Content />
    </div>

    <footer class="note-foot">
      <a class="arrow-link" href="/notes">←&nbsp; Back to all notes</a>
    </footer>
  </article>
</Base>

<style>
  .note {
    max-width: 44rem;
  }
  .note-head {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .note-head h1 {
    font-size: var(--step-3);
  }
  .back {
    align-self: start;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .tags {
    display: inline-flex;
    gap: 0.5rem;
  }
  .tag {
    color: var(--accent-text);
  }
  .note-foot {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
