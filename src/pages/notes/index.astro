---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// group by year
const byYear = new Map<number, typeof notes>();
for (const n of notes) {
  const y = n.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(n);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const md = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "short", day: "2-digit" });
---

<Base title="Notes" description="Working notes, essays, and things I want to remember.">
  <section class="wrap head" data-reveal-group>
    <span class="kicker" data-reveal><span class="idx">[ / ]</span> Notes</span>
    <h1 data-reveal>Working notes &amp; things<br />I want to remember.</h1>
    <p class="lead" data-reveal>
      Written in the open, revised often. No schedule, no newsletter — just a
      <a class="link" href="/rss.xml">feed</a> if you want one.
    </p>
  </section>

  <section class="wrap">
    {
      years.map((year) => (
        <div class="year-block" data-reveal-group>
          <h2 class="year" data-reveal>{year}</h2>
          <ul class="list">
            {byYear.get(year)!.map((note) => (
              <li data-reveal>
                <a class="row" href={`/notes/${note.id}/`}>
                  <time datetime={note.data.date.toISOString()}>
                    {md(note.data.date)}
                  </time>
                  <span class="row-main">
                    <span class="row-title">{note.data.title}</span>
                    {note.data.description && (
                      <span class="row-desc">{note.data.description}</span>
                    )}
                  </span>
                  <span class="row-go" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 7vw, 4rem);
  }
  .head h1 {
    font-size: var(--step-3);
  }

  .year-block {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
  }
  .year {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    color: var(--text-faint);
    font-weight: 400;
    position: sticky;
    top: 78px;
    align-self: start;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0.4rem;
    border-radius: 10px;
    transition: background 0.2s, padding-left 0.3s var(--ease-out);
  }
  .row:hover {
    background: var(--bg-raised);
    padding-left: 0.9rem;
  }
  .row time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .row-main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .row-title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .row-desc {
    font-size: var(--step--1);
    color: var(--text-dim);
  }
  .row-go {
    color: var(--text-faint);
    transition: transform 0.3s var(--ease-out), color 0.2s;
  }
  .row:hover .row-go {
    color: var(--accent-text);
    transform: translateX(3px);
  }

  @media (max-width: 620px) {
    .year-block {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
    .year {
      position: static;
    }
    .row {
      grid-template-columns: 1fr auto;
    }
    .row time {
      grid-column: 1 / -1;
    }
  }
</style>
