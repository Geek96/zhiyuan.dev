---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Base
  title="Dashboard"
  description="Selected work, recent notes, and what I'm doing right now."
>
  <section class="wrap head" data-reveal-group>
    <span class="kicker" data-reveal><span class="idx">[ / ]</span> Dashboard</span>
    <h1 data-reveal>Everything, at a glance.</h1>
  </section>

  <section class="wrap">
    <div class="section-head">
      <span class="kicker"><span class="idx">[01]</span> Selected work</span>
      <a class="arrow-link" href="/projects">All projects</a>
    </div>
    <div class="grid" data-reveal-group>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <hr class="rule" />

  <section class="wrap">
    <div class="section-head">
      <span class="kicker"><span class="idx">[02]</span> Recent notes</span>
      <a class="arrow-link" href="/notes">Archive</a>
    </div>
    <ul class="notes" data-reveal-group>
      {
        notes.map((note) => (
          <li data-reveal>
            <a class="note-row" href={`/notes/${note.id}/`}>
              <time datetime={note.data.date.toISOString()}>
                {fmt(note.data.date)}
              </time>
              <span class="note-title">{note.data.title}</span>
              <span class="note-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="rule" />

  <section class="wrap now-teaser" data-reveal-group>
    <span class="kicker" data-reveal><span class="idx">[03]</span> Right now</span>
    <p class="now-line" data-reveal>
      Currently heads-down on a planning system for my notes, learning to make
      the web feel handmade again, and reading more fiction than I have in years.
    </p>
    <a class="arrow-link" href="/now" data-reveal>→&nbsp; The full /now page</a>
  </section>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: clamp(2.5rem, 7vw, 4rem);
  }
  .head h1 {
    font-size: var(--step-3);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: 1rem;
  }

  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .note-row {
    display: grid;
    grid-template-columns: 9.5rem 1fr auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1.15rem 0.25rem;
    border-bottom: 1px solid var(--border);
    transition: padding-left 0.3s var(--ease-out), background 0.2s;
  }
  .note-row:hover {
    padding-left: 0.9rem;
    background: linear-gradient(90deg, var(--accent-soft), transparent 40%);
  }
  .note-row time {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .note-title {
    color: var(--text);
    font-size: var(--step-1);
    font-family: var(--font-serif);
    letter-spacing: -0.01em;
  }
  .note-go {
    color: var(--text-faint);
    transition: transform 0.3s var(--ease-out), color 0.2s;
  }
  .note-row:hover .note-go {
    color: var(--accent-text);
    transform: translateX(3px);
  }

  .now-teaser {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .now-line {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.4;
    max-width: 24ch;
    color: var(--text);
  }

  @media (max-width: 560px) {
    .note-row {
      grid-template-columns: 1fr auto;
    }
    .note-row time {
      grid-column: 1 / -1;
    }
  }
</style>
