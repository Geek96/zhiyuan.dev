---
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";
---

<Base bareFooter>
  <section class="landing" data-reveal-group>
    <div class="portrait" data-reveal>
      <img
        src={site.photo}
        alt={site.name}
        width="1400"
        height="1050"
        onerror="this.remove()"
      />
      <span class="portrait-fallback" aria-hidden="true">{site.name[0]}</span>
    </div>

    <p class="welcome" data-reveal>{site.welcome}</p>

    <a class="cta" href="/dashboard" data-reveal data-magnetic="0.15">
      Enter the dashboard
      <span aria-hidden="true">→</span>
    </a>
  </section>
</Base>

<style>
  .landing {
    min-height: calc(100dvh - 58px - 6rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.75rem;
    padding-block: clamp(2rem, 8vw, 4rem);
  }

  .portrait {
    position: relative;
    width: min(100%, 680px);
    /* matches the source photo (1400x1050) exactly, so object-fit: cover
       below crops nothing in practice — it's just a safety net if a
       differently-shaped photo ever gets swapped in */
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.45);
  }
  .portrait img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .portrait-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--bg-raised), var(--bg-inset));
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 12vw, 6rem);
    font-variation-settings: "SOFT" 30, "WONK" 0;
    color: var(--accent-text);
  }

  .welcome {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1.35;
    max-width: 22ch;
    color: var(--text);
    text-wrap: balance;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--text);
    transition:
      border-color 0.25s,
      background 0.25s,
      color 0.25s;
  }
  .cta:hover {
    border-color: var(--accent-text);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .cta span {
    transition: transform 0.3s var(--ease-out);
  }
  .cta:hover span {
    transform: translateX(3px);
  }
</style>
