---
import { socials, site } from "../lib/site";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-links" data-reveal-group>
      {
        socials.map((s) => (
          <a
            class="footer-link"
            href={s.href}
            data-reveal
            {...(s.href.startsWith("/")
              ? {}
              : { target: "_blank", rel: "noopener me" })}
          >
            <span class="footer-link-label">{s.label}</span>
            <span class="footer-link-handle">{s.handle}</span>
          </a>
        ))
      }
    </div>

    <p class="footer-meta">
      <span>© {year} {site.name}</span>
      <span class="footer-dot">·</span>
      <span>Built with Astro</span>
      <span class="footer-dot">·</span>
      <span
        >Press <kbd>⌘</kbd><kbd>K</kbd> anywhere</span
      >
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(4rem, 12vw, 8rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .footer-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg);
    transition: background 0.2s;
  }
  .footer-link:hover {
    background: var(--bg-raised);
  }
  .footer-link-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .footer-link-handle {
    color: var(--text);
    transition: color 0.2s;
  }
  .footer-link:hover .footer-link-handle {
    color: var(--accent-text);
  }
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-faint);
  }
  .footer-dot {
    opacity: 0.5;
  }
  .footer-meta kbd {
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05em 0.3em;
    margin: 0 0.05em;
  }
</style>
